# Copy to .env and fill in. Never commit the real .env.

# Required for skills/level/division extraction (the crawl alone works without it).
# Get one at console.anthropic.com -> API Keys. Starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - only needed to email reports.
# SMTP_USER must be the Gmail account that generated the app password
# (myaccount.google.com/apppasswords, requires 2FA).
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
REPORT_EMAIL_TO=recipient@example.com
